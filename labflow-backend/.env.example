# Server
# Required. Supported values: development, test, production.
NODE_ENV=development
PORT=5000

# Reverse proxy trust.
# Production defaults to 1 proxy hop when unset.
# Supported values: true, false, or a positive integer.
TRUST_PROXY=

# Database
# Do not add sslmode, sslcert, sslkey, or sslrootcert to DATABASE_URL.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/labflow_db

# Hosted and production databases use TLS automatically.
# Certificate verification defaults to true.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Optional PEM CA certificate for databases using a private/self-signed CA.
# Escaped \n sequences are converted to real newlines.
DATABASE_SSL_CA=

# Authentication
# Production requires at least 32 characters
JWT_SECRET=replace_with_a_long_random_secret


# Frontend and CORS
# Production FRONTEND_URL must use HTTPS
FRONTEND_URL=http://localhost:5173

# Attachment storage
ATTACHMENT_STORAGE_PROVIDER=r2

# Attachment limits and URL expiry
ATTACHMENT_MAX_FILE_SIZE_BYTES=26214400
ATTACHMENT_PENDING_TTL_MINUTES=30
ATTACHMENT_UPLOAD_URL_TTL_SECONDS=300
ATTACHMENT_DOWNLOAD_URL_TTL_SECONDS=60
ATTACHMENT_CLEANUP_BATCH_SIZE=100

# Cloudflare R2
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET_NAME=replace_with_private_bucket_name

# Email delivery
# Supported values: disabled, mailgun
EMAIL_PROVIDER=disabled

EMAIL_FROM_NAME=LabFlow
EMAIL_FROM_ADDRESS=no-reply@example.com

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# US: https://api.mailgun.net
# EU: https://api.eu.mailgun.net
MAILGUN_API_BASE_URL=https://api.mailgun.net

# Account-security behavior
# These expiry values are application constants and do not require environment variables.
# Password-reset tokens expire after 30 minutes.
# Email-verification tokens expire after 24 hours.
# JWTs expire after 7 days and use users.tokenVersion for session invalidation.

# Logging
# Production defaults to info. Development may use debug for SQL visibility.
LOG_LEVEL=info