PORT=5000

# Local example:
# # Local example:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/labflow_db

# Production example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Use a long random secret in real environments.
# Do not reuse this placeholder.
JWT_SECRET=replace_with_a_long_random_secret

# Use development locally and production on deployed backend.
NODE_ENV=development

# Local frontend:
# FRONTEND_URL=http://localhost:5173

# Production frontend:
# FRONTEND_URL=https://your-frontend-domain.com

FRONTEND_URL=http://localhost:5173

# Attachment storage
ATTACHMENT_STORAGE_PROVIDER=r2

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional. Derived from R2_ACCOUNT_ID when omitted.
R2_ENDPOINT=

ATTACHMENT_MAX_FILE_SIZE_BYTES=26214400
ATTACHMENT_UPLOAD_URL_TTL_SECONDS=300
ATTACHMENT_DOWNLOAD_URL_TTL_SECONDS=60
ATTACHMENT_PENDING_TTL_MINUTES=30

ATTACHMENT_CLEANUP_BATCH_SIZE=100